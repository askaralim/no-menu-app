{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/events/map-navigation-clicked-v1.schema.json",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "map_navigation_clicked"
        },
        "schema_version": {
          "const": 1
        },
        "source": {
          "$ref": "../common/primitives.schema.json#/$defs/source"
        },
        "selected_city_code": {
          "anyOf": [
            {
              "$ref": "../common/primitives.schema.json#/$defs/city"
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant_id": {
          "$ref": "../common/primitives.schema.json#/$defs/uuid"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "campaign": {
          "$ref": "./campaign-context.schema.json"
        }
      },
      "required": [
        "event_name",
        "schema_version",
        "source",
        "selected_city_code",
        "tenant_id",
        "provider"
      ]
    }
  ],
  "unevaluatedProperties": false
}
