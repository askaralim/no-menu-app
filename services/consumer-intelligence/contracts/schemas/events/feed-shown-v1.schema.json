{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/events/feed-shown-v1.schema.json",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "feed_shown"
        },
        "schema_version": {
          "const": 1
        },
        "feed": {
          "type": "object",
          "properties": {
            "feed_instance_id": {
              "$ref": "../common/primitives.schema.json#/$defs/uuid"
            }
          },
          "required": [
            "feed_instance_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_name",
        "schema_version",
        "feed"
      ]
    }
  ],
  "unevaluatedProperties": false
}
