{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/events/batch.schema.json",
  "type": "object",
  "properties": {
    "batch_id": {
      "$ref": "../common/primitives.schema.json#/$defs/uuid"
    },
    "installation_id": {
      "$ref": "../common/primitives.schema.json#/$defs/uuid"
    },
    "client": {
      "type": "object",
      "properties": {
        "application": {
          "enum": [
            "ios",
            "miniprogram",
            "taplist"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "app_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "application",
        "platform",
        "app_version"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "batch_id",
    "installation_id",
    "client",
    "events"
  ],
  "additionalProperties": false,
  "description": "Envelope validation only: malformed event objects are intentionally admitted for per-item validation against events/event.schema.json. Unknown event versions do not reject valid siblings. Whole body <=65536 UTF-8 bytes; each event <=8192 bytes.",
  "x-event-schema": {
    "$ref": "./event.schema.json"
  }
}
