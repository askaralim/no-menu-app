{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/identity/accepted.schema.json",
  "allOf": [
    {
      "$ref": "../common/primitives.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "../common/primitives.schema.json#/$defs/uuid"
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        }
      },
      "required": [
        "operation_id",
        "status"
      ]
    }
  ]
}
