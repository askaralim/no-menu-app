{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/identity/operation.schema.json",
  "type": "object",
  "properties": {
    "operation_id": {
      "$ref": "../common/primitives.schema.json#/$defs/uuid"
    },
    "action": {
      "enum": [
        "link",
        "unlink"
      ]
    },
    "installation_id": {
      "$ref": "../common/primitives.schema.json#/$defs/uuid"
    },
    "session_id": {
      "$ref": "../common/primitives.schema.json#/$defs/uuid"
    },
    "session_started_at": {
      "$ref": "../common/primitives.schema.json#/$defs/time"
    },
    "occurred_at": {
      "$ref": "../common/primitives.schema.json#/$defs/time"
    }
  },
  "required": [
    "operation_id",
    "action",
    "installation_id",
    "session_id",
    "session_started_at",
    "occurred_at"
  ],
  "additionalProperties": false
}
