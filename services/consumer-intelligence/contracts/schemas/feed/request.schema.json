{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/feed/request.schema.json",
  "type": "object",
  "properties": {
    "city_code": {
      "$ref": "../common/primitives.schema.json#/$defs/city"
    },
    "mode": {
      "enum": [
        "for_you",
        "latest"
      ]
    },
    "surface": {
      "enum": [
        "home",
        "feed_page"
      ]
    },
    "feed_instance_id": {
      "$ref": "../common/primitives.schema.json#/$defs/uuid"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "cursor": {
      "$ref": "../common/primitives.schema.json#/$defs/cursor"
    }
  },
  "required": [
    "city_code",
    "mode",
    "surface",
    "feed_instance_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "for_you"
          }
        }
      },
      "then": {
        "properties": {
          "limit": {
            "maximum": 20
          }
        },
        "not": {
          "required": [
            "cursor"
          ]
        }
      }
    }
  ]
}
