{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nomenu.invalid/v1/common/error.schema.json",
  "allOf": [
    {
      "$ref": "./primitives.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    }
  ]
}
