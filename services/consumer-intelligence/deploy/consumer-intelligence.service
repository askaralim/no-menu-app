[Unit]
Description=No Menu Consumer Intelligence API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nomenu-ci
Group=nomenu-ci
WorkingDirectory=/opt/no-menu/consumer-intelligence
EnvironmentFile=/etc/no-menu/consumer-intelligence-api.env
ExecStart=/usr/bin/python3 /usr/local/libexec/nomenu-ci/e1-reader-launcher.py /opt/no-menu/consumer-intelligence /etc/no-menu/e1-aware-readers.sha256 api
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=384M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target
