# Local-only example. Never reuse these passwords/secrets in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=8791
CI_DATABASE_URL=postgresql://ci_local:ci_local_only@127.0.0.1:55432/nomenu_ci_test
CI_DATABASE_TLS=disable
CI_DB_POOL_MAX=5
CI_USER_KEY_SECRET=replace-with-a-random-secret-at-least-32-bytes
CI_CURSOR_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-publishable-key
# Worker only. Do not put this in the HTTP API process environment.
# SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=
RECENT_TAP_WINDOW_DAYS=14
# Production: CI_DATABASE_TLS=verify-full and provider CA bundle if required.
# CI_DATABASE_CA_FILE=/etc/nomenu-ci/rds-ca.pem
