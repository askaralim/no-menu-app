# =============================================================================
# Local Supabase (Docker) — mirrors hosted Supabase Postgres + REST + Auth
# =============================================================================
# 1) Start Docker Desktop
# 2) From repo root: npm run db:start   (downloads images once; Postgres on :54322)
# 3) Apply schema once: paste supabase/install_all_in_one.sql in Studio → SQL Editor
#    Studio: http://127.0.0.1:54323
#
# For Next.js dev, values in `.env.development.local` override `.env.local`.
# Easiest fix if `.env.local` still points at the cloud URL:
#     cp .env.development.local.example .env.development.local
#

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Same anon key shipped with Supabase CLI local stack (JWT for role "anon").
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Direct Postgres URL (CLI default user/password/database). Useful for pgAdmin/psql —
# Next.js talks to Postgres through Supabase (URL/key above), not this string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
