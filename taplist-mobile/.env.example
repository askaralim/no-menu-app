# Cloud Supabase (hosted project).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Local Supabase CLI: copy .env.local.example to .env and use http://127.0.0.1:54321 + Publishable key from `supabase status`.

# App Store Connect — required for submission (public HTTPS page).
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://nomenuapp.com/privacy

# PostHog product analytics (Project Settings > Project token).
EXPO_PUBLIC_POSTHOG_API_KEY=phc_REPLACE_WITH_PROJECT_TOKEN
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
