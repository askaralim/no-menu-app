{
  "expo": {
    "name": "No Menu",
    "slug": "no-menu-app",
    "version": "1.3.2",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/470f9d09-531f-4478-a32c-6a2217b79a87"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomenuapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.nomenuapp.taplist",
      "buildNumber": "48",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "No Menu 需要访问相册权限以保存酒单图片。",
        "NSPhotoLibraryAddUsageDescription": "No Menu 需要保存酒单图片到你的相册。"
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nomenuapp.taplist"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "No Menu 使用你当前的位置，为所选城市的酒吧按距离排序。你的位置不会被保存。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "No Menu 需要访问相册权限以保存酒单图片。",
          "savePhotosPermission": "No Menu 需要保存酒单图片到你的相册。",
          "preventAutomaticLimitedAccessAlert": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "470f9d09-531f-4478-a32c-6a2217b79a87"
      }
    },
    "owner": "askar.alim"
  }
}
