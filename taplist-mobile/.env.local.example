# Copy to `.env` in this folder. Restart Expo after changes.
#
# Expo Web on http://127.0.0.1:8081 + Supabase on the same machine: use 127.0.0.1 below (not a LAN IP).
# If you still have a LAN IP here, taplist-mobile rewires to loopback when the page is 127.0.0.1/localhost.
#
# From monorepo root: `supabase status`
#   Project URL uses port 54321 — use that for EXPO_PUBLIC_SUPABASE_URL.
#   Paste the Publishable (anon) key; it changes after `supabase db reset`.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME_FROM_supabase_status

# Physical device: use your Mac LAN IP instead of 127.0.0.1
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
