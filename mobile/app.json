{
  "expo": {
    "name": "No Menu Tonight",
    "slug": "nomenu",
    "scheme": "nomenu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taklip.nomenuapp",
      "buildNumber": "16",
      "infoPlist": {
        "CFBundleDisplayName": "NM Tonight",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "zh-Hans",
        "NSPhotoLibraryUsageDescription": "No Menu Tonight 需要访问相册，以便你为酒款选择并上传图片到今晚酒单。",
        "NSPhotoLibraryAddUsageDescription": "No Menu Tonight 需要访问相册，以便保存酒款图片和门店二维码。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.taklip.nomenuapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "No Menu Tonight 需要访问相册，以便你为酒款选择并上传图片到今晚酒单。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "No Menu Tonight 需要访问相册，以便保存门店二维码。",
          "savePhotosPermission": "No Menu Tonight 需要访问相册，以便保存门店二维码。",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25370b31-037e-42a1-b6ce-16bf661e1ccc"
      }
    }
  }
}
